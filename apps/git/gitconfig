[user]
	name = apascualco
	email = apascualco@gmail.com

[core]
	excludesfile = /Users/apascualco/.gitignore_global
	editor = nvim

[init]
	defaultBranch = main

[fetch]
	prune = true
	pruneTags = true

[pull]
	rebase = true

[rebase]
	autoStash = true

[push]
	autoSetupRemote = true
	followTags = true

[rerere]
	enabled = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[branch]
	sort = -committerdate

[column]
	ui = auto
