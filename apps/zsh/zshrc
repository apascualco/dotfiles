# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================
export LANG=en_US.UTF-8
export EDITOR="nvim"
export ZSH="$HOME/.oh-my-zsh"

# Android SDK
export ANDROID_SDK_ROOT=$HOME/Library/Android/sdk
export ANDROID_HOME=$HOME/Library/Android/sdk

# Go configuration - will be overridden by GVM if loaded
export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"

# SDKMAN
export SDKMAN_DIR="$HOME/.sdkman"

# ============================================================================
# PATH CONFIGURATION
# ============================================================================
# Dedupe PATH automatically: re-sourcing ~/.zshrc (rr/lsource/esource) no longer
# accumulates duplicate entries.
typeset -U path PATH

# Homebrew (this already adds /opt/homebrew/bin)
eval "$(/opt/homebrew/bin/brew shellenv)"

# GNU binaries (static path, avoids slow brew --prefix + find on every shell start)
for bindir in /opt/homebrew/opt/*/libexec/gnubin; do
  [[ -d "$bindir" ]] && export PATH="$bindir:$PATH"
done

# Android SDK
export PATH=$ANDROID_SDK_ROOT/emulator:$ANDROID_SDK_ROOT/platform-tools:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$PATH

# Go
export PATH="$GOPATH/bin:$PATH"

# Python (picks up whichever python@3.x is installed via brew)
for py_bin in /opt/homebrew/opt/python@3*/libexec/bin; do
  [[ -d "$py_bin" ]] && export PATH="$py_bin:$PATH"
done

# Maven (only if installed)
[[ -d "$HOME/workdir/tools/apache-maven-3.9.6/bin" ]] && export PATH="$HOME/workdir/tools/apache-maven-3.9.6/bin:$PATH"

# LLVM
export PATH="/opt/homebrew/opt/llvm/bin:$PATH"

# Bash
export PATH="/opt/homebrew/bin/bash:$PATH"

# Local binaries (Claude Code, etc.)
export PATH="$HOME/.local/bin:$PATH"

# System paths
export PATH="/usr/local/bin:$PATH"

# Pin Homebrew's 3.12 as the default python3/pip3 — must stay AFTER /usr/local/bin,
# which still holds stale system-3.9 pip shims (pip / pip3 / pip3.9).
[[ -d /opt/homebrew/opt/python@3.12/libexec/bin ]] && export PATH="/opt/homebrew/opt/python@3.12/libexec/bin:$PATH"

# ============================================================================
# POWERLEVEL10K INSTANT PROMPT
# ============================================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================================================
# OH MY ZSH CONFIGURATION
# ============================================================================
ZSH_THEME="powerlevel10k/powerlevel10k"
HIST_STAMPS="yyyy-mm-dd"

plugins=(
  git
  git-flow
  docker
  docker-compose
  kubectl
  golang
  python
  rust
  z
  sudo
  extract
  copypath
  copyfile
  web-search
  brew
  colored-man-pages
  command-not-found
  dirhistory
  jsontools
  encode64
  zsh-syntax-highlighting
  zsh-autosuggestions
  zsh-completions
  fzf
)

source $ZSH/oh-my-zsh.sh

# ============================================================================
# POWERLEVEL10K CONFIGURATION
# ============================================================================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ============================================================================
# TOOL INITIALIZATION
# ============================================================================
# Cargo
source "$HOME/.cargo/env"

# GVM
[[ -s "$HOME/.gvm/scripts/gvm" ]] && source "$HOME/.gvm/scripts/gvm" 2>/dev/null
# GVM overrides cd() to auto-switch Go version/pkgset from .go-version/.go-pkgset files.
# That override is buggy under zsh — it "quietly fails" (Go still works) but spams
# "command not found: _encode/_decode" on every cd. We don't use per-directory switching,
# so drop the override and keep the plain builtin cd. `gvm use`/`gvm install` are
# unaffected; only .go-version/.go-pkgset auto-switching is disabled.
(( $+functions[cd] )) && unfunction cd
# Update GOBIN after GVM loads (uses current GOPATH). Guarded so we don't spawn
# `go` on every shell start when Go isn't installed.
if (( $+commands[go] )); then
  export GOBIN="$(go env GOPATH)/bin"
  export PATH="$GOBIN:$PATH"
fi

# SDKMAN
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# FZF
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Kubectl completion (cached — regenerating it on every shell start is slow)
if (( $+commands[kubectl] )); then
  kubectl_cache="${XDG_CACHE_HOME:-$HOME/.cache}/kubectl-completion.zsh"
  [[ -s "$kubectl_cache" ]] || kubectl completion zsh > "$kubectl_cache"
  source "$kubectl_cache"
fi

# ============================================================================
# OPTIONAL PRIVATE CONFIGURATION
# ============================================================================
[[ -f ~/.local_zshrc ]] && source ~/.local_zshrc
[[ -f ~/.local_zshrc_alternative ]] && source ~/.local_zshrc_alternative

# ============================================================================
# FZF CONFIGURATION
# ============================================================================
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :500 {}' --preview-window=right:60%:wrap"
export FZF_ALT_C_OPTS="--preview 'ls -la --color=always {}' --preview-window=right:60%:wrap"
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window=down:40%:wrap"

# ============================================================================
# EZA CONFIGURATION
# ============================================================================
export EZA_CONFIG_DIR="$HOME/Library/Application Support/eza"

# ============================================================================
# ALIASES - Docker
# ============================================================================
alias di='docker images'
alias dca='docker ps -a'
alias dri='docker rmi --force $(docker images -a -q)'
alias drc='docker rm $(docker ps -a -q)'

# ============================================================================
# ALIASES - Shell Configuration
# ============================================================================
alias lsource='source ~/.zshrc'
alias esource='nvim ~/.zshrc'

# ============================================================================
# ALIASES - Kubernetes
# ============================================================================
alias kapp='kubectl apply -f '
alias kdapp='kubectl delete -f '

# ============================================================================
# ALIASES - Python
# ============================================================================
alias pte='./.venv/bin/pytest '
alias pdist='.venv/bin/python setup.py sdist'
alias venvc='virtualenv .venv --python='
alias venv3='virtualenv .venv --python=python3'
alias venva='source .venv/bin/activate'
alias venvd='deactivate'

# ============================================================================
# ALIASES - Development Tools
# ============================================================================
alias ctags="/opt/homebrew/bin/ctags"
alias n='nvim .'
alias claudes='claude --dangerously-skip-permissions --brief --effort high --model claude-sonnet-4-8'
alias claudesx='claude --dangerously-skip-permissions --brief --effort max --model claude-sonnet-4-8'
alias claudex='claude --dangerously-skip-permissions --brief --effort max --model claude-opus-4-8'
# Codex uses the model/provider in ~/.codex/config.toml; override effort only.
alias codexs='codex --dangerously-bypass-approvals-and-sandbox -c model_reasoning_effort="high"'
alias codexsx='codex --dangerously-bypass-approvals-and-sandbox -c model_reasoning_effort="xhigh"'
alias idea='open -na "IntelliJ IDEA.app" --args '

# ============================================================================
# ALIASES - Navigation
# ============================================================================
alias wdgo='cd ~/workdir/code/go'
alias wdrust='cd ~/workdir/code/rust'
alias wdinfra='cd ~/workdir/code/infra'

# ============================================================================
# ALIASES - Gradle
# ============================================================================
alias gbc='./gradlew build --continuous --info'
alias gbc.='../gradlew build --continuous --info'
alias gbc..='../../gradlew build --continuous --info'

# ============================================================================
# ALIASES - Git
# ============================================================================
alias cab='git branch --merged | grep -v "\*" | xargs -n 1 git branch -d'
alias gss='git stash push -m'        # gss "description"
alias gsl='git stash list'
alias gsp='git stash pop'
alias gsd='git stash drop'
alias rr='source ~/.zshrc'

# ============================================================================
# ALIASES - System
# ============================================================================
alias fckcache='sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder'

# ============================================================================
# ALIASES - Tmux
# ============================================================================
alias t='tmux'
tn() { if [ -n "$TMUX" ]; then tmux new-session -d -s "$1" && tmux switch-client -t "$1"; else tmux new -s "$1"; fi }
alias ta='tmux attach -t'
alias td='tmux detach'
alias ts='tmux switch -t'
alias tas='tmux attach-session'
alias th='tmux split-window -h'
alias tv='tmux split-window -v'
alias tk='tmux kill-session -t'
alias tka='tmux kill-server'

# ============================================================================
# ALIASES - File Listing (eza)
# ============================================================================
alias ls='eza --color=always --group-directories-first --icons -F'
alias ll='eza -lh --group-directories-first --icons -F'
alias la='eza -lha --group-directories-first --icons -F'
alias lt='eza -T -L 2 --icons --color=always'

alias kc='killall claude'

# To customize prompt, run `p10k configure` or edit ~/.dotfiles/apps/zsh/p10k.zsh.
# (p10k is already sourced above via ~/.p10k.zsh, a symlink to that same file.)

# ============================================================================
# Text-to-Speech (edge-tts)
# ============================================================================
sES() {
  /Library/Developer/CommandLineTools/usr/bin/python3 -m edge_tts --text "$*" --voice es-ES-AlvaroNeural --write-media /tmp/tts.mp3 && afplay /tmp/tts.mp3
}

sEN() {
  /Library/Developer/CommandLineTools/usr/bin/python3 -m edge_tts --text "$*" --voice en-GB-RyanNeural --write-media /tmp/tts.mp3 && afplay /tmp/tts.mp3
}

# opencode
export PATH=/Users/apascualco/.opencode/bin:$PATH

# Ghostty shell integration (manual source — p10k instant prompt blocks auto-injection)
if [[ -n "$GHOSTTY_RESOURCES_DIR" && -z "$TMUX" ]]; then
  source "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration"
fi


